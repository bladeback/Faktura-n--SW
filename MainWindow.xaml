<Window x:Class="InvoiceApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InvoiceApp 2026"
        Height="850"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.AppBackground}">

    <Window.Resources>
        <!-- Modern Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Icon placeholder if needed -->
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Active Indicator Bar (Hidden by default) -->
                                <Border x:Name="indicator" Width="4" Height="20" HorizontalAlignment="Left"
                                        Background="{DynamicResource Brush.Primary}" CornerRadius="2"
                                        Visibility="Collapsed" Margin="0,0,10,0"/>

                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active State Style -->
        <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource Brush.CardHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12">
                             <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Indicator Visible for Active -->
                                <Border x:Name="indicator" Width="4" Height="20" HorizontalAlignment="Left"
                                        Background="{DynamicResource Brush.Primary}" CornerRadius="2"
                                        Visibility="Visible" Margin="0,0,10,0">
                                     <Border.Effect>
                                         <!-- Neon Glow in Dark Mode -->
                                         <DropShadowEffect Color="{DynamicResource Color.PrimaryGlow}" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                     </Border.Effect>
                                </Border>

                                <ContentPresenter Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/> <!-- Sidebar width -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- FLOATING SIDEBAR -->
        <!-- We use a subtle transparent background + blur effect logic ideally, 
             but standard WPF blur is heavy. We simulate glass with semi-transparent CardBackground -->
        <Border Grid.Column="0" Margin="20,20,0,20"
                Background="{DynamicResource Brush.CardBackground}"
                CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="30" ShadowDepth="5"/>
            </Border.Effect>
            
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Logo -->
                    <RowDefinition Height="*"/>    <!-- Menu -->
                    <RowDefinition Height="Auto"/> <!-- User/Footer -->
                </Grid.RowDefinitions>

                <!-- LOGO AREA -->
                <StackPanel Grid.Row="0" Margin="0,20,0,40">
                    <TextBlock Text="INVOICE" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.TextPrimary}"/>
                    <TextBlock Text="APP 2026" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Primary}" Margin="2,-5,0,0"/>
                </StackPanel>

                <!-- NAVIGATION MENU -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU" Style="{StaticResource SubtleText}" Margin="10,0,0,10" Opacity="0.5"/>
                    
                    <Button x:Name="NavDashboard" Content="Přehled" Click="Dashboard_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="NavInvoices" Content="Faktury" Click="Invoices_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="NavOrders" Content="Objednávky" Click="Orders_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="NavCustomers" Content="Odběratelé" Click="Customers_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="NavSuppliers" Content="Dodavatelé" Click="Suppliers_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="NavItems" Content="Položky" Click="Items_Click" Style="{StaticResource NavButtonStyle}"/>
                    
                    <Separator Background="{DynamicResource Brush.Border}" Margin="10,20,10,20" Opacity="0.3"/>
                    
                    <TextBlock Text="SYSTÉM" Style="{StaticResource SubtleText}" Margin="10,0,0,10" Opacity="0.5"/>
                    <Button x:Name="NavHistory" Content="Historie dokladů" Click="History_Click" Style="{StaticResource NavButtonStyle}"/>
                    <Button x:Name="NavSettings" Content="Nastavení" Click="Settings_Click" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>

                <!-- FOOTER / THEME TOGGLE -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <!-- Theme Toggle Placeholder (Functionality to be added in code behind) -->
                    <Border Background="{DynamicResource Brush.AppBackground}" CornerRadius="12" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Tmavý režim" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Přepnout vzhled" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/>
                            </StackPanel>
                            <!-- Simple CheckBox for now as toggle -->
                            <CheckBox Grid.Column="1" VerticalAlignment="Center" x:Name="ThemeToggle" Click="ThemeToggle_Click" IsChecked="True">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </Grid>
                    </Border>
                    
                    <TextBlock Text="v0.9 Beta" Foreground="{DynamicResource Brush.TextDisabled}" 
                               FontSize="11" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <ContentControl x:Name="ContentHost"
                        Grid.Column="1"
                        Margin="30,20,20,20"/>

    </Grid>
</Window>
