<UserControl x:Class="InvoiceApp.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InvoiceApp.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="White">

    <UserControl.DataContext>
        <vm:DashboardViewModel/>
    </UserControl.DataContext>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Přehled" Style="{StaticResource Heading1}"/>
            <ComboBox Grid.Column="1" Width="100" ItemsSource="{Binding AvailableYears}" SelectedItem="{Binding SelectedYear}"
                      VerticalAlignment="Center" HorizontalContentAlignment="Center" FontWeight="SemiBold"/>
        </Grid>

        <!-- Karty se statistikami -->
        <WrapPanel Grid.Row="1">
            <!-- Měsíční tržby -->
            <Border Width="220" Height="140" Margin="0,0,20,20" 
                    Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Fakturováno tento měsíc" Foreground="#1E40AF" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalRevenueMonth, StringFormat={}{0:N0} Kč}" 
                               FontSize="28" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Roční tržby -->
            <Border Width="220" Height="140" Margin="0,0,20,20" 
                    Background="#F0FDF4" BorderBrush="#DCFCE7" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedYear, StringFormat='Celkem rok {0}'}" Foreground="#166534" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalRevenueYear, StringFormat={}{0:N0} Kč}" 
                               FontSize="28" FontWeight="Bold" Foreground="#14532D" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Neuhrazeno -->
            <Border Width="220" Height="140" Margin="0,0,20,20" 
                    Background="#FEF2F2" BorderBrush="#FEE2E2" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Neuhrazeno celkem" Foreground="#991B1B" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TotalUnpaid, StringFormat={}{0:N0} Kč}" 
                               FontSize="28" FontWeight="Bold" Foreground="#7F1D1D" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Počet dokladů -->
            <Border Width="220" Height="140" Margin="0,0,20,20" 
                    Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Vystavené doklady (rok)" Foreground="#475569" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding CountInvoicesYear}" FontSize="28" FontWeight="Bold" Foreground="#334155"/>
                        <TextBlock Text=" faktur" FontSize="16" VerticalAlignment="Bottom" Margin="4,0,0,5" Foreground="#64748B"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CountOrdersYear}" FontSize="20" FontWeight="SemiBold" Foreground="#334155"/>
                        <TextBlock Text=" objednávek" FontSize="14" VerticalAlignment="Bottom" Margin="4,0,0,3" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </WrapPanel>
        
        <!-- Placeholder pro graf nebo seznam posledních -->
        <!-- Graf vývoje tržeb -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20">
            <Border.Resources>
                <Style x:Key="SegmentButton" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#64748B"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="16,6"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Text="{Binding SelectedYear, StringFormat='Vývoj tržeb v roce {0}'}" FontSize="16" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    
                    <!-- Segmented Control -->
                    <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="20" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Měsíce" Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:ChartPeriod.Months}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPeriod}" Value="{x:Static vm:ChartPeriod.Months}">
                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Content="Kvartály" Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:ChartPeriod.Quarters}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPeriod}" Value="{x:Static vm:ChartPeriod.Quarters}">
                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            
                            <Button Content="Roky" Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static vm:ChartPeriod.Years}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SegmentButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPeriod}" Value="{x:Static vm:ChartPeriod.Years}">
                                                <Setter Property="Background" Value="#8B5CF6"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <ItemsControl Grid.Row="1" ItemsSource="{Binding MonthlyStats}" VerticalAlignment="Bottom">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid VerticalAlignment="Bottom" Margin="5,0" ToolTip="{Binding Tooltip}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <!-- Sloupec -->
                                <Border Grid.Row="0" Width="30" Height="{Binding Height}" 
                                        Background="{Binding Color}" CornerRadius="4,4,0,0"
                                        VerticalAlignment="Bottom"/>
                                
                                <!-- Popisek -->
                                <TextBlock Grid.Row="1" Text="{Binding Label}" 
                                           HorizontalAlignment="Center" Margin="0,5,0,0" 
                                           FontSize="12" Foreground="#64748B"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>
