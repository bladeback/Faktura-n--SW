<UserControl x:Class="InvoiceApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InvoiceApp.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="White">

    <UserControl.DataContext>
        <vm:SettingsViewModel/>
    </UserControl.DataContext>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Nastavení aplikace" 
                   FontSize="28" FontWeight="Bold" Foreground="#1E293B"
                   Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock Text="Číslování dokladů" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="#334155"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Rok:" VerticalAlignment="Center" Foreground="#64748B"/>
                    <TextBox Grid.Column="1" Text="{Binding CurrentYear, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="5" BorderBrush="#CBD5E1"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Další číslo faktury:" VerticalAlignment="Center" Foreground="#64748B"/>
                    <TextBox Grid.Column="1" Text="{Binding NextInvoiceNumber}" 
                             Padding="5" BorderBrush="#CBD5E1"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Další číslo objednávky:" VerticalAlignment="Center" Foreground="#64748B"/>
                    <TextBox Grid.Column="1" Text="{Binding NextOrderNumber}" 
                             Padding="5" BorderBrush="#CBD5E1"/>
                </Grid>

                <Button Content="Uložit nastavení" 
                        Command="{Binding SaveSettingsCommand}"
                        HorizontalAlignment="Left"
                        Padding="20,10"
                        Background="#2563EB" Foreground="White" FontWeight="Bold" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="2" Text="Poznámka: Změny se projeví okamžitě." 
                   Foreground="#94A3B8" FontStyle="Italic" Margin="0,10,0,0"/>

    </Grid>
</UserControl>
