<UserControl x:Class="InvoiceApp.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InvoiceApp.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="{DynamicResource Brush.AppBackground}">
    <UserControl.Resources>
        <!-- Local Style for Formatting Buttons -->
        <Style x:Key="FormattingButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Toolbar -->
            <RowDefinition Height="*"/>    <!-- Content (Tabs) -->
            <RowDefinition Height="Auto"/> <!-- Footer (Save Button) -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nastavení aplikace" Style="{StaticResource Heading1}" Margin="0,0,0,24"/>

        <!-- Číslování dokladů Section - kept inside a ScrollViewer in the main content area or separate? 
             Actually, the user wants the Save button always visible. 
             So we should put the main content in a ScrollViewer in Row 2. -->

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
            <StackPanel>
                <!-- Číslování dokladů -->
                <Border Style="{StaticResource GroupCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Číslování dokladů" Style="{StaticResource Heading2}"/>
                            <Button Grid.Column="1" Content="Uložit číslování" 
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </Grid>
                        
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Rok:" Style="{StaticResource FormLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding CurrentYear, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBox}"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Další číslo faktury:" Style="{StaticResource FormLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding NextInvoiceNumber}" Style="{StaticResource FormTextBox}"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Další číslo objednávky:" Style="{StaticResource FormLabel}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding NextOrderNumber}" Style="{StaticResource FormTextBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Patička a Odkazy -->
                <Border Style="{StaticResource GroupCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Patička a Odkazy" Style="{StaticResource Heading2}"/>
                            <Button Grid.Column="1" Content="Uložit vzhled" 
                                    Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </Grid>

                        <!-- Formatting Toolbar (Shared) -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Background="{DynamicResource Brush.Surface}">
                            <Button Content="B" FontWeight="Bold" Click="InsertBold_Click" ToolTip="Tučně" Style="{StaticResource FormattingButton}"/>
                            <Button Content="I" FontStyle="Italic" Click="InsertItalic_Click" ToolTip="Kurzíva" Style="{StaticResource FormattingButton}"/>
                            <Button Content="S" FontSize="10" Click="InsertSize_Click" ToolTip="Velikost" Style="{StaticResource FormattingButton}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="10" Click="SizeItem_Click" Tag="10"/>
                                        <MenuItem Header="11" Click="SizeItem_Click" Tag="11"/>
                                        <MenuItem Header="12" Click="SizeItem_Click" Tag="12"/>
                                        <MenuItem Header="14" Click="SizeItem_Click" Tag="14"/>
                                        <MenuItem Header="16" Click="SizeItem_Click" Tag="16"/>
                                        <MenuItem Header="18" Click="SizeItem_Click" Tag="18"/>
                                        <MenuItem Header="20" Click="SizeItem_Click" Tag="20"/>
                                        <MenuItem Header="24" Click="SizeItem_Click" Tag="24"/>
                                        <Separator/>
                                        <MenuItem Header="Vlastní..." Click="InsertSize_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="Color" FontSize="10" Width="40" Click="InsertColor_Click" ToolTip="Barva" Style="{StaticResource FormattingButton}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Černá" Click="ColorItem_Click" Tag="#000000">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#000000" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Červená" Click="ColorItem_Click" Tag="#FF0000">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#FF0000" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Modrá" Click="ColorItem_Click" Tag="#0000FF">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#0000FF" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Zelená" Click="ColorItem_Click" Tag="#008000">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#008000" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Oranžová" Click="ColorItem_Click" Tag="#FFA500">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#FFA500" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Žlutá" Click="ColorItem_Click" Tag="#FFFF00">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#FFFF00" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Fialová" Click="ColorItem_Click" Tag="#800080">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#800080" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Růžová" Click="ColorItem_Click" Tag="#FF1493">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#FF1493" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Tyrkysová" Click="ColorItem_Click" Tag="#008080">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#008080" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Hnědá" Click="ColorItem_Click" Tag="#A52A2A">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#A52A2A" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Šedá" Click="ColorItem_Click" Tag="#808080">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#808080" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Vlastní..." Click="InsertColor_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <Button Content="Bg" FontSize="10" Click="InsertBg_Click" ToolTip="Pozadí" Style="{StaticResource FormattingButton}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Černá" Click="BgItem_Click" Tag="#000000">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#000000" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Červená" Click="BgItem_Click" Tag="#FF0000">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#FF0000" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Modrá" Click="BgItem_Click" Tag="#0000FF">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#0000FF" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Zelená" Click="BgItem_Click" Tag="#008000">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#008000" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Oranžová" Click="BgItem_Click" Tag="#FFA500">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#FFA500" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Žlutá" Click="BgItem_Click" Tag="#FFFF00">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#FFFF00" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Fialová" Click="BgItem_Click" Tag="#800080">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#800080" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Růžová" Click="BgItem_Click" Tag="#FF1493">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#FF1493" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Tyrkysová" Click="BgItem_Click" Tag="#008080">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#008080" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Hnědá" Click="BgItem_Click" Tag="#A52A2A">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#A52A2A" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Šedá" Click="BgItem_Click" Tag="#808080">
                                            <MenuItem.Icon><Border Width="10" Height="10" Background="#808080" BorderBrush="Gray" BorderThickness="1"/></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="Vlastní..." Click="InsertBg_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                            <TextBlock Text="Označte text a klikněte na tlačítko." VerticalAlignment="Center" Style="{StaticResource SubtleText}" FontSize="11" Margin="8,0,0,0"/>
                        </StackPanel>

                        <TabControl Margin="0,0,0,0" BorderThickness="0" Background="Transparent">
                            <TabControl.Resources>
                                <Style TargetType="TabItem">
                                    <Setter Property="FontSize" Value="14"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Margin" Value="0,0,5,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border Name="Border" BorderThickness="0,0,0,2" BorderBrush="Transparent" Margin="0,0,5,0">
                                                    <ContentPresenter x:Name="ContentSite"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Center"
                                                        ContentSource="Header"
                                                        Margin="10,5"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.Resources>

                            <!-- FAKTURA TAB -->
                            <TabItem Header="Faktura">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Text patičky:" Style="{StaticResource FormLabel}" Margin="0,0,0,5"/>
                                    <TextBox x:Name="FooterInvoiceBox" Text="{Binding FooterInvoice, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                             Style="{StaticResource FormTextBox}" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto"
                                             TextChanged="FooterInvoiceBox_TextChanged"/>
                                    
                                    <TextBlock Text="Náhled:" Style="{StaticResource FormLabel}" FontSize="11" Margin="0,0,0,2"/>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="White" Padding="10" Margin="0,0,0,24" MinHeight="40">
                                        <TextBlock x:Name="PreviewInvoice" TextWrapping="Wrap" FontSize="11" Foreground="Black"/>
                                    </Border>

                                    <Grid Margin="0,0,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="Webová adresa (URL):" Style="{StaticResource FormLabel}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding InvoiceUrl}" Style="{StaticResource FormTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="Zobrazený text odkazu:" Style="{StaticResource FormLabel}" Margin="0,0,0,5"/>
                                            <TextBox Text="{Binding InvoiceUrlText}" Style="{StaticResource FormTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </TabItem>

                            <!-- OBJEDNÁVKA TAB -->
                            <TabItem Header="Objednávka">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Text patičky:" Style="{StaticResource FormLabel}" Margin="0,0,0,5"/>
                                    <TextBox x:Name="FooterOrderBox" Text="{Binding FooterOrder, UpdateSourceTrigger=PropertyChanged}" 
                                             Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                             Style="{StaticResource FormTextBox}" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto"
                                             TextChanged="FooterOrderBox_TextChanged"/>

                                    <TextBlock Text="Náhled:" Style="{StaticResource FormLabel}" FontSize="11" Margin="0,0,0,2"/>
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Background="White" Padding="10" Margin="0,0,0,24" MinHeight="40">
                                        <TextBlock x:Name="PreviewOrder" TextWrapping="Wrap" FontSize="11" Foreground="Black"/>
                                    </Border>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <!-- Zálohování a data -->
                <!-- Zálohování a data -->
                <Border Style="{StaticResource GroupCard}" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Zálohování a data" Style="{StaticResource Heading2}" Margin="0,0,0,12"/>
                        
                        <TextBlock Text="Zde můžete vytvořit kompletní zálohu všech dat aplikace (faktury, klienti, nastavení) nebo data obnovit ze zálohy." 
                                   Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Vytvořit zálohu" 
                                    Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,16,0"/>

                            <Button Content="Obnovit ze zálohy" 
                                    Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- TOVÁRNÍ NASTAVENÍ -->
                <!-- TOVÁRNÍ NASTAVENÍ -->
                <Border Style="{StaticResource GroupCard}" BorderBrush="{DynamicResource Brush.Danger}" Background="Transparent">
                    <StackPanel>
                        <TextBlock Text="Tovární nastavení" Style="{StaticResource Heading1}" Margin="0,0,0,12" Foreground="{DynamicResource Brush.Danger}"/>
                        <TextBlock Text="Tato akce smaže všechna data aplikace (faktury, klienty, nastavení)." 
                                   Style="{StaticResource SubtleText}" Margin="0,0,0,16"/>
                        <Button Content="Resetovat aplikaci a smazat data"
                                Command="{Binding FactoryResetCommand}"
                                Style="{StaticResource DangerButton}"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
