<UserControl x:Class="InvoiceApp.Views.ItemsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:InvoiceApp.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="White">

    <UserControl.DataContext>
        <vm:ItemsViewModel/>
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Položky (Ceník)" Style="{StaticResource Heading1}"/>
                <TextBlock Text="{Binding Count, StringFormat='  ({0})'}"
                           Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource SubtleText}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Přidat" Command="{Binding AddCommand}" Style="{StaticResource ToolbarButton}"/>
            </StackPanel>
        </Grid>

        <!-- Grid -->
        <DataGrid Grid.Row="1" Margin="16,0,16,16"
                  ItemsSource="{Binding Items}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="True"
                  Style="{StaticResource ModernDataGrid}">
            
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=SelectedItem}"/>
            </DataGrid.InputBindings>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Název položky" Binding="{Binding Name}" Width="3*"/>
                <DataGridTextColumn Header="Cena bez DPH" Binding="{Binding UnitPrice, StringFormat=F2}" Width="*"/>
                <DataGridTextColumn Header="DPH (0.21 = 21%)" Binding="{Binding VatRate}" Width="*"/>
                <DataGridTextColumn Header="Jednotka" Binding="{Binding Unit}" Width="*"/>
                
                <DataGridTemplateColumn Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Smazat" 
                                    Command="{Binding DataContext.DeleteSelectedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource ToolbarButton}"
                                    Background="#EF4444" Foreground="White" Margin="2"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
