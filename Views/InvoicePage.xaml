<UserControl x:Class="InvoiceApp.Views.InvoicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:InvoiceApp.Models"
             Background="Transparent">

    <DockPanel>
        <!-- TOOLBAR -->
        <Border DockPanel.Dock="Top" 
                Background="White" 
                BorderBrush="{StaticResource Brush.Border}" 
                BorderThickness="0,0,0,1" 
                Padding="16,12">
            <StackPanel Orientation="Horizontal">
                <Button Content="Nová faktura"
                        Command="{Binding NewInvoiceCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Nová objednávka"
                        Command="{Binding NewOrderCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Invoice}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Border Width="1" Height="24" Background="{StaticResource Brush.Border}" Margin="12,0"/>
                
                <Button Content="Přidat položku"
                        Command="{Binding AddItemCommand}"
                        Style="{StaticResource ToolbarButton}"/>
                
                <Border Width="1" Height="24" Background="{StaticResource Brush.Border}" Margin="12,0"/>
                
                <Button Content="Export do PDF"
                        Command="{Binding ExportPdfCommand}"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="450"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEVÁ STRANA (Formuláře) -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">

                    <!-- DOKLAD -->
                    <Border Style="{StaticResource GroupCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Doklad" Style="{StaticResource Heading1}" Margin="0,0,0,12"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>



                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Číslo:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1"
                                           Text="{Binding DisplayNumber, Mode=OneWay}"
                                           IsReadOnly="True"
                                           Style="{StaticResource FormTextBox}"
                                           Background="#F9FAFB"
                                           Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Vystaveno:" Style="{StaticResource FormLabel}"/>
                                <DatePicker Grid.Row="2" Grid.Column="1"
                                            SelectedDate="{Binding Current.IssueDate}"
                                            Margin="0,4"
                                            VerticalContentAlignment="Center"
                                            Padding="4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Splatnost:">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <DatePicker Grid.Row="3" Grid.Column="1"
                                            SelectedDate="{Binding Current.DueDate}"
                                            Margin="0,4"
                                            VerticalContentAlignment="Center"
                                            Padding="4">
                                    <DatePicker.Style>
                                        <Style TargetType="DatePicker">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DatePicker.Style>
                                </DatePicker>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Splatnost (dny):">
                                     <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                         Text="{Binding PaymentTermDays, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DODAVATEL -->
                    <Border Style="{StaticResource GroupCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Dodavatel" Style="{StaticResource Heading1}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Rychlý výběr:" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Foreground="{StaticResource Brush.Primary}"/>
                                <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                           ItemsSource="{Binding SavedSuppliers}"
                                           SelectedItem="{Binding SelectedSavedSupplier, Mode=TwoWay}"
                                           DisplayMemberPath="Name"
                                           Style="{StaticResource FormComboBox}"
                                           Margin="0,4"
                                           IsEditable="True"
                                           IsTextSearchEnabled="True"
                                           Text="{Binding SupplierSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Název:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Supplier.Name}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ulice:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Supplier.Address}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Město/PSČ:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Supplier.City}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Země:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Supplier.Country}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="IČO:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding Current.Supplier.ICO}" Style="{StaticResource FormTextBox}" Margin="0,4,8,4"/>
                                <Button    Grid.Row="5" Grid.Column="2" Content="Načíst z ARES" Command="{Binding LoadSupplierFromIcoCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="DIČ:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Supplier.DIC}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <!-- Banka (skrýt pro objednávku) -->
                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Banka:">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ComboBox Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2"
                                          ItemsSource="{Binding Banks}"
                                          SelectedItem="{Binding SelectedBank, Mode=TwoWay}"
                                          IsEditable="False"
                                          IsTextSearchEnabled="True"
                                          Margin="0,4">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <Run Text="{Binding Name}"/><Run Text=" ("/><Run Text="{Binding Code}"/><Run Text=")"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource FormComboBox}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="Účet:">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2"
                                         Text="{Binding Current.Supplier.AccountNumber, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,4">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <TextBlock Grid.Row="9" Grid.Column="0" Text="IBAN:">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2"
                                         Text="{Binding Current.Supplier.IBAN, Mode=TwoWay, Converter={StaticResource IbanDisplay}, UpdateSourceTrigger=LostFocus}"
                                         Margin="0,4">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <TextBlock Grid.Row="10" Grid.Column="0" Text="SWIFT:">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2"
                                         Text="{Binding Current.Supplier.SWIFT}"
                                         Margin="0,4">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource FormTextBox}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <TextBlock Grid.Row="11" Grid.Column="0" Text="E-mail:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Supplier.Email}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="12" Grid.Column="0" Text="Telefon:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="12" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Supplier.Phone}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="13" Grid.Column="0" Text="Plátce DPH:" Style="{StaticResource FormLabel}"/>
                                <CheckBox  Grid.Row="13" Grid.Column="1" IsChecked="{Binding SupplierIsVatPayer}" Style="{StaticResource FormCheckBox}" Margin="0,12,0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ODBĚRATEL -->
                    <Border Style="{StaticResource GroupCard}" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Odběratel" Style="{StaticResource Heading1}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Rychlý výběr:" Style="{StaticResource FormLabel}" VerticalAlignment="Center" Foreground="{StaticResource Brush.Primary}"/>
                                <ComboBox  Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                           ItemsSource="{Binding SavedCustomers}"
                                           SelectedItem="{Binding SelectedSavedCustomer, Mode=TwoWay}"
                                           DisplayMemberPath="Name"
                                           Style="{StaticResource FormComboBox}"
                                           Margin="0,4"
                                           IsEditable="True"
                                           IsTextSearchEnabled="True"
                                           Text="{Binding CustomerSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Název:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Customer.Name}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Ulice:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Customer.Address}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Město/PSČ:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Customer.City}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Země:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Customer.Country}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="IČO:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" Text="{Binding Current.Customer.ICO}" Style="{StaticResource FormTextBox}" Margin="0,4,8,4"/>
                                <Button    Grid.Row="5" Grid.Column="2" Content="Načíst z ARES" Command="{Binding LoadCustomerFromIcoCommand}" Style="{StaticResource SecondaryButton}" Margin="0,4"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="DIČ:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Current.Customer.DIC}" Style="{StaticResource FormTextBox}" Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PLATEBNÍ ÚDAJE -->
                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource GroupCard}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Current.Type}" Value="{x:Static models:DocType.Order}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Platební údaje" Style="{StaticResource Heading1}" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Var. symbol:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Current.VariableSymbol}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Konst. symbol:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding Current.ConstantSymbol}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Způsob úhrady:" Style="{StaticResource FormLabel}"/>
                                <ComboBox  Grid.Row="2" Grid.Column="1"
                                           ItemsSource="{Binding PaymentMethods}"
                                           SelectedItem="{Binding Current.PaymentMethod, Mode=TwoWay}"
                                           Style="{StaticResource FormComboBox}"
                                           Margin="0,4"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Datum zd. plnění:" Style="{StaticResource FormLabel}"/>
                                <DatePicker Grid.Row="3" Grid.Column="1"
                                            SelectedDate="{Binding Current.TaxableSupplyDate}"
                                            Margin="0,4" VerticalContentAlignment="Center" Padding="4"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Měna:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" Text="{Binding Current.Currency}" Style="{StaticResource FormTextBox}" Margin="0,4"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Poznámka:" Style="{StaticResource FormLabel}" VerticalAlignment="Top"/>
                                <TextBox   Grid.Row="5" Grid.Column="1"
                                           Text="{Binding Current.Notes}"
                                           AcceptsReturn="True"
                                           Height="80"
                                           Style="{StaticResource FormTextBox}"
                                           Margin="0,4"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- PRAVÁ STRANA (Položky) -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" 
                            Background="White" 
                            BorderBrush="{StaticResource Brush.Border}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Margin="0,0,0,16">
                        <DataGrid x:Name="ItemsGrid"
                                  ItemsSource="{Binding Items}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  BorderThickness="0"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E5E7EB"
                                  VerticalGridLinesBrush="Transparent"
                                  RowStyle="{StaticResource ModernRowStyle}"
                                  CellStyle="{StaticResource ModernCellStyle}"
                                  ColumnHeaderStyle="{StaticResource ModernHeaderStyle}"
                                  Background="Transparent">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Položka" Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                <DataGridTextColumn Header="Mj" Binding="{Binding Unit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <DataGridTextColumn Header="Množství" Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DecimalComma}}" Width="80"/>
                                <DataGridTextColumn Header="Cena/ks" Binding="{Binding UnitPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource WholeNumber}}" Width="100"/>
                                <DataGridTemplateColumn x:Name="VatColumn" Header="DPH (%)" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding VatRate, Converter={StaticResource VatPercent}, StringFormat=N0}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox IsEditable="True"
                                                      StaysOpenOnEdit="True"
                                                      HorizontalContentAlignment="Left"
                                                      Text="{Binding VatRate, Mode=TwoWay, Converter={StaticResource VatPercent}, UpdateSourceTrigger=LostFocus}"
                                                      KeyDown="VatCombo_KeyDown">
                                                <ComboBoxItem Content="0"/>
                                                <ComboBoxItem Content="10"/>
                                                <ComboBoxItem Content="12"/>
                                                <ComboBoxItem Content="21"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕"
                                                    Command="{Binding DataContext.RemoveSelectedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource IconButton}"
                                                    Foreground="{StaticResource Brush.Danger}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- SOUČTY -->
                    <Border Grid.Row="1" Style="{StaticResource GroupCard}">
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                <TextBlock Text="Základ bez DPH:" Margin="0,0,12,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SupplierIsVatPayer}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding SubtotalDisplay}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SupplierIsVatPayer}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                <TextBlock Text="DPH celkem:" Margin="0,0,12,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SupplierIsVatPayer}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding VatTotalDisplay}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SupplierIsVatPayer}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                <TextBlock Text="Zaokrouhlení:" Margin="0,0,12,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubtleText}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRounding}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding RoundingDisplay}" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShowRounding}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,8,0,12"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Celkem k úhradě:" FontSize="18" FontWeight="Bold" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
