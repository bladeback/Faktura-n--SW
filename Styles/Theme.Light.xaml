<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- LIGHT THEME PALETTE (Clean/Airy) -->
    
    <!-- Backgrounds -->
    <Color x:Key="Color.AppBackground">#F3F4F6</Color> <!-- Slate 100 -->
    <SolidColorBrush x:Key="Brush.AppBackground" Color="{StaticResource Color.AppBackground}"/>

    <Color x:Key="Color.CardBackground">#FFFFFF</Color>
    <SolidColorBrush x:Key="Brush.CardBackground" Color="{StaticResource Color.CardBackground}"/>

    <Color x:Key="Color.CardHover">#F8FAFC</Color> <!-- Slate 50 -->
    <SolidColorBrush x:Key="Brush.CardHover" Color="{StaticResource Color.CardHover}"/>

    <Color x:Key="Color.Border">#E2E8F0</Color> <!-- Slate 200 -->
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>

    <!-- Typography -->
    <Color x:Key="Color.TextPrimary">#0F172A</Color> <!-- Slate 900 -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>

    <Color x:Key="Color.TextSecondary">#64748B</Color> <!-- Slate 500 -->
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>

    <Color x:Key="Color.TextDisabled">#94A3B8</Color> <!-- Slate 400 -->
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}"/>

    <!-- Accents -->
    <Color x:Key="Color.Primary">#2563EB</Color> <!-- Blue 600 -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    
    <Color x:Key="Color.PrimaryDark">#1E40AF</Color> <!-- Blue 800 -->
    <SolidColorBrush x:Key="Brush.PrimaryDark" Color="{StaticResource Color.PrimaryDark}"/>

    <!-- Gradient for Primary Buttons -->
    <LinearGradientBrush x:Key="Brush.PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/> 
        <GradientStop Color="#3B82F6" Offset="1"/> 
    </LinearGradientBrush>
    
    <!-- Glow Effect Color (None/Transparent for Light Mode usually, or faint Blue) -->
    <Color x:Key="Color.PrimaryGlow">#00000000</Color>

    <!-- Secondary Accents -->
    <Color x:Key="Color.Secondary">#651FFF</Color> <!-- Purple -->
    <SolidColorBrush x:Key="Brush.Secondary" Color="{StaticResource Color.Secondary}"/>

    <Color x:Key="Color.Success">#16A34A</Color> <!-- Green 600 -->
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>

    <Color x:Key="Color.Warning">#CA8A04</Color> <!-- Amber 600 -->
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>

    <Color x:Key="Color.Danger">#DC2626</Color> <!-- Red 600 -->
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>

    <!-- UI Specifics -->
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#CBD5E1"/> <!-- Slate 300 -->
    
    <!-- ScrollBar -->
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.ScrollTrack" Color="Transparent"/>

</ResourceDictionary>
